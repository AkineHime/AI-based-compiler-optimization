// generated: composite sr+cf+branch

int part0(int reps) {
    int acc = 0;
    for (int i = 0; i < reps; i = i + 1) {
        acc = acc + i * 7 + i * 11 + i * 13 + 3;
    }
    return acc;
}

int part1(int reps) {
    int acc = 0;
    for (int i = 0; i < reps; i = i + 1) {
        int p = 20;
        int q = 30;
        int r = 35;
        acc = acc + p * p + q * p * q + q * r + (i - (i / 7) * 7);
    }
    return acc;
}

int part2(int reps) {
    int acc = 0;
    for (int i = 0; i < reps; i = i + 1) {
        if (i - (i / 4) * 4 == 0) {
            acc = acc + i * 3 + 31 * 8;
        } else {
            acc = acc + i * 7 - (i - (i / 5) * 5);
        }
    }
    return acc;
}

int main() {
    int s = 0;
    s = s + part0(800000);
    s = s + part1(3000000);
    s = s + part2(3000000);
    return ((s % 251) + 251) % 251;
}
