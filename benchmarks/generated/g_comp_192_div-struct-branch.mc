    int i = 0;
    while (i < reps) {
        int u = 62927;
        int v = 75978;
        acc = acc + 1242396155 / u + 1800252025 / v + i / (u - (u / 100) * 100 + 1);
        i = i + 1;
    }
    return acc;
}

int part1(int reps) {
    int acc = 0;
    int i = 0;
    while (i < reps) {
        struct __Box bb;
        bb.x0 = 32; bb.y0 = 9; bb.x1 = 71; bb.y1 = 66;
        int w = bb.x1 - bb.x0;
        int h = bb.y1 - bb.y0;
        acc = acc + w * h + w * w + h * h + w * h * i;
        i = i + 1;
