}

int part2(int reps) {
    int acc = 0;
    int i = 0;
    while (i < reps) {
        if (i - (i / 3) * 3 == 0) {
            acc = acc + i * 39 + 19 * 4;
        } else {
            acc = acc + i * 26 - (i - (i / 5) * 5);
        }
        i = i + 1;
    }
