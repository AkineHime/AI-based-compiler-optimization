int part2(int reps) {
    int acc = 0;
    int i = 0;
    while (i < reps) {
        int p = 35;
        int q = 26;
        int r = 15;
        acc = acc + p * q + q * p * q + p * p + r * r * p + (i - (i / 7) * 7);
        i = i + 1;
    }
    return acc;
}

int part3(int reps) {
    int acc = 0;
    int i = 0;
    while (i < reps) {
        struct __Box bb;
        bb.x0 = 16; bb.y0 = 16; bb.x1 = 81; bb.y1 = 67;
        int w = bb.x1 - bb.x0;
        int h = bb.y1 - bb.y0;
        acc = acc + w * h + w * w + h * h + w * h * i;
        i = i + 1;
    }
    return acc;
}

