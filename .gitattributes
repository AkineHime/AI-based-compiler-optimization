# Normalize line endings — store everything as LF in the repo.
* text=auto eol=lf
*.mc   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.html text eol=lf
*.json text eol=lf

# Binary — never touch
*.png  binary
*.pdf  binary
*.pkl  binary
*.npz  binary
*.exe  binary

# GitHub language stats: .mc is MiniC (a C dialect), not Garmin "Monkey C".
*.mc linguist-language=C
# Generated / report artifacts shouldn't skew the language bar.
reports/** linguist-documentation
docs/**    linguist-documentation
